# font settings
font-family = GeistMono Nerd Font
font-size = 12
font-feature = -liga
font-feature = -calt
font-feature = -dlig
theme=Aura


gtk-single-instance = true
gtk-titlebar = false
window-decoration = false
window-vsync = false
confirm-close-surface = false
background-opacity = 0.7

window-padding-x = 3
window-padding-y = 8
window-padding-balance = false


shell-integration-features = no-cursor,no-sudo,no-title
cursor-style-blink = false


keybind=ctrl+1=text:\x021
keybind=ctrl+2=text:\x022
keybind=ctrl+3=text:\x023
keybind=ctrl+4=text:\x024
keybind=ctrl+5=text:\x025
keybind=ctrl+6=text:\x026
keybind=ctrl+7=text:\x027
keybind=ctrl+8=text:\x028
keybind=ctrl+9=text:\x029

# Vertical split (Ctrl + T)
keybind=ctrl+t=text:\x02%

# Horizontal split (Ctrl + I)
keybind=ctrl+i=text:\x02"

# New window (Ctrl + N)
keybind=ctrl+n=text:\x02c

# Close pane (Ctrl + W)
keybind=ctrl+w=text:\x02x

